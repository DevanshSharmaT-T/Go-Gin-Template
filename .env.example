# ===========================================================================
# Go + Gin Backend Template — configuration reference
#
#   cp .env.example .env
#
# This is the ONLY committed env file and it contains placeholders only.
# Never put a real credential in here.
#
# Loading is TIERED and later files OVERRIDE earlier ones:
#
#     .env  ->  .env.$GO_ENV  ->  .env.$GO_ENV.local
#
# Put shared defaults in `.env`, per-environment values in `.env.<env>`, and
# machine-specific overrides (a throwaway database, a local mail catcher) in
# `.env.<env>.local`. All of those are gitignored.
#
# Legend:  [required]  the app refuses to start without it
#          [default: x] the value used when the key is absent
# ===========================================================================


# --- Runtime ---------------------------------------------------------------

# Selects the .env.<env> tier. One of: development | test | staging | production.
# Validated at startup, so a typo cannot silently load no tier at all.
GO_ENV=development                          # [default: development]

# Application name used in logs, JWT issuer default and mail subjects.
APP_NAME=go-gin-template                    # [default: go-gin-template]

# Public base URL of THIS API. Used to build absolute links in outgoing mail.
APP_BASE_URL=http://localhost:8080          # [default: http://localhost:8080]


# --- Logging ---------------------------------------------------------------

# trace | debug | info | warn | error | fatal | panic
LOG_LEVEL=debug                             # [default: info]

# json    — structured, one object per line (use in staging/production)
# console — human-readable, coloured (use in development)
LOG_FORMAT=console                          # [default: json]


# --- HTTP server -----------------------------------------------------------

SERVICE_HOST=127.0.0.1                      # [default: 127.0.0.1]
SERVICE_PORT=8080                           # [default: 8080]

# Server-level timeouts. Unbounded timeouts let a slow client hold a
# connection open indefinitely, so every one of these is set by default.
SERVER_READ_TIMEOUT=15s                     # [default: 15s]
SERVER_WRITE_TIMEOUT=30s                    # [default: 30s]
SERVER_IDLE_TIMEOUT=60s                     # [default: 60s]
SERVER_HEADER_TIMEOUT=10s                   # [default: 10s]

# Per-request deadline enforced by the timeout middleware. Must be shorter
# than SERVER_WRITE_TIMEOUT or the client is cut off before the 503 is sent.
REQUEST_TIMEOUT=25s                         # [default: 25s]

# How long in-flight requests get to finish after SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT=15s                        # [default: 15s]

# Maximum accepted request body size. Rejected with 413 above this.
MAX_REQUEST_BODY_BYTES=1048576              # [default: 1048576 (1 MiB)]

# Trusted reverse-proxy CIDRs. Leave EMPTY when the app is internet-facing
# without a proxy: an empty list means X-Forwarded-For is ignored, so a
# client cannot spoof its own IP and evade the rate limiter.
TRUSTED_PROXIES=                            # [default: empty]


# --- Database [required] ---------------------------------------------------

# PostgreSQL only. The role must be allowed to CREATE EXTENSION "uuid-ossp",
# which runs at boot. Migrations and seeders also run on EVERY start.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app?sslmode=disable

# Connection pool. Keep MAX_OPEN below your server's max_connections divided
# by the number of replicas.
DATABASE_MAX_OPEN_CONNS=25                  # [default: 25]
DATABASE_MAX_IDLE_CONNS=5                   # [default: 5]
DATABASE_CONN_MAX_LIFETIME=1h               # [default: 1h]
DATABASE_CONN_MAX_IDLE_TIME=10m             # [default: 10m]

# silent | error | warn | info — GORM's own query logger.
DATABASE_LOG_LEVEL=warn                     # [default: warn]


# --- Auth / JWT [required] -------------------------------------------------

# Generate a real one:   openssl rand -base64 48
#
# Validated at startup. The app REFUSES TO BOOT if this is empty, shorter
# than 32 characters, or still set to the placeholder below. That is
# deliberate — an unvalidated secret silently signs tokens with an empty key.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Signed into the `iss` claim and required to match on verification.
JWT_ISSUER=go-gin-template                  # [default: value of APP_NAME]

# Access-token lifetime. Keep it short; permission changes are also revoked
# out-of-band by the token-version check.
JWT_TTL=24h                                 # [default: 24h]

# bcrypt work factor. 12 is a reasonable 2020s default; every +1 doubles the
# hashing time. Below 10 is not acceptable in production.
BCRYPT_COST=12                              # [default: 12]

# HMAC key for email-verification and password-reset tokens. Optional: when
# empty it is derived from JWT_SECRET via HKDF with a distinct info label, so
# the two never share key material. Set it explicitly to rotate them apart.
TOKEN_SECRET=                               # [default: derived from JWT_SECRET]

VERIFICATION_TOKEN_TTL=24h                  # [default: 24h]
PASSWORD_RESET_TOKEN_TTL=1h                 # [default: 1h]


# --- CORS ------------------------------------------------------------------

# Comma-separated exact origins. There is NO wildcard default.
#
# `*` is rejected at startup when CORS_ALLOW_CREDENTIALS is true, because the
# combination is invalid per the Fetch standard and browsers that accept it
# expose every authenticated endpoint to any site.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true                 # [default: true]
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_EXPOSED_HEADERS=X-Request-ID
CORS_MAX_AGE=12h                            # [default: 12h]


# --- Rate limiting ---------------------------------------------------------

RATE_LIMIT_ENABLED=true                     # [default: true]

# Global per-client-IP token bucket, applied to every route.
RATE_LIMIT_RPS=20                           # [default: 20]
RATE_LIMIT_BURST=40                         # [default: 40]

# Tighter bucket for the unauthenticated auth routes (login, register,
# password reset). Credential stuffing is the thing this exists to slow down.
AUTH_RATE_LIMIT_RPM=10                      # [default: 10]
AUTH_RATE_LIMIT_BURST=5                     # [default: 5]


# --- Outbound mail ---------------------------------------------------------

# smtp — real delivery
# log  — render the template and write it to the logger; sends nothing.
#        The default, so a fresh clone runs with no mail server at all.
MAIL_DRIVER=log                             # [default: log]

MAIL_FROM_ADDRESS=no-reply@example.com      # [default: no-reply@example.com]
MAIL_FROM_NAME=Go Gin Template              # [default: value of APP_NAME]

# Only read when MAIL_DRIVER=smtp. For local testing point at a mail catcher
# such as MailHog or Mailpit on :1025 rather than a real provider.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025                              # [default: 587]
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls                           # none | starttls | tls  [default: starttls]
SMTP_TIMEOUT=10s                            # [default: 10s]


# --- Frontend --------------------------------------------------------------

# Base URL of the client app. Verification and password-reset links are built
# from this, so it must be an origin you control.
FRONTEND_URL=http://localhost:3000          # [default: http://localhost:3000]


# --- Seed administrator (optional) -----------------------------------------

# Creates one administrator on first boot. If any of the three is missing the
# seeder skips and LOGS A WARNING (it does not fail, and it does not stay
# silent). Change the password immediately after the first login.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_before_first_boot


# --- Google OAuth (optional) -----------------------------------------------

# Leave blank to disable the Google sign-in route entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback


# --- Observability (optional) ----------------------------------------------

# Blank disables Sentry; nothing is sent and no middleware is installed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=                         # [default: value of GO_ENV]
SENTRY_TRACES_SAMPLE_RATE=0.0               # [default: 0.0 (errors only)]


# --- Testing ---------------------------------------------------------------

# Read by the integration and e2e suites, which SKIP when it is unset — so
# `go test ./...` stays green on a machine with no database.
#
# NEVER point this at a database you care about: the suites run real
# migrations and write real rows. `make test-db-up` starts a disposable one.
TEST_DATABASE_URL=postgres://postgres:test@127.0.0.1:55433/app_test?sslmode=disable
